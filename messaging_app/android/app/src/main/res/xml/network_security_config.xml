<?xml version="1.0" encoding="utf-8"?>
<!-- The messaging server's dev URL is plain HTTP (127.0.0.1:8000, and the
     emulator's 10.0.2.2 loopback), which Android 9+ blocks by default.
     Cleartext stays limited to those loopback hosts; the prod URL is HTTPS
     and needs no exception. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
